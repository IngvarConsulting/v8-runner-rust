    "launch_app": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "MCP request for `launch_app`.",
      "properties": {
        "mcpConfig": {
          "description": "Optional client MCP config path passed as runMcp=<FILE>.",
          "type": [
            "string",
            "null"
          ]
        },
        "mcpPort": {
          "description": "Optional client MCP port override.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mcpScenario": {
          "description": "Optional client MCP scenario. Use va for Vanessa Automation.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "Client mode for utilityType=mcp: thin, thick, or ordinary.",
          "type": [
            "string",
            "null"
          ]
        },
        "utilityType": {
          "description": "Client type to launch. Examples: mcp, client-mcp; thin-client, thin, tc; thick-client, thick; designer, configurator.",
          "type": "string"
        },
        "via": {
          "description": "Which address opens the base: web for infobase.web.url, connection for infobase.connection. Thin client only; the default follows the target kind.",
          "type": [
            "string",
            "null"
          ]
        },
        "waitReady": {
          "description": "Wait until the client MCP endpoint responds to initialize and tools/list.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "utilityType"
      ],
      "title": "McpLaunchAppRequest",
      "type": "object"
    },
