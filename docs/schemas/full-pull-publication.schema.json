{
  "$defs": {
    "ArtifactKind": {
      "description": "Stable artifact classification for runner/package outputs.",
      "oneOf": [
        {
          "enum": [
            "run_directory",
            "config",
            "package",
            "report",
            "runner_log",
            "platform_log",
            "sentinel"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a single retained artifact.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "ArtifactSet": {
      "additionalProperties": false,
      "description": "A retained artifact collection for a single execution.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "root_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DumpMode": {
      "enum": [
        "FULL",
        "INCREMENTAL",
        "PARTIAL"
      ],
      "type": "string"
    },
    "DumpModeReason": {
      "description": "Почему случившийся режим не тот, что просили.",
      "oneOf": [
        {
          "const": "version_file",
          "description": "Файла версий нет или версия формата в нём не распознана: выгрузка полная.",
          "type": "string"
        },
        {
          "const": "foreign_format",
          "description": "Версия формата в файле версий не та, что пишет платформа: выгрузка полная.",
          "type": "string"
        },
        {
          "const": "platform_forecast",
          "description": "`ibcmd` предсказал полную выгрузку (`modified: all`).",
          "type": "string"
        },
        {
          "const": "platform_rewrote_all",
          "description": "Выгрузка Конфигуратора или агента с обновлением переписала каждый файл набора.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Прогноз `ibcmd` не распознан или не получен либо каталог после выгрузки не\nперечислен: режим не известен.",
          "type": "string"
        }
      ]
    },
    "Envelope": {
      "additionalProperties": false,
      "description": "Shared machine-readable command payload for CLI JSON and MCP structured content.",
      "properties": {
        "command": {
          "type": "string"
        },
        "data": true,
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvelopeError"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepResult"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "command",
        "duration_ms",
        "data",
        "warnings",
        "steps"
      ],
      "type": "object"
    },
    "EnvelopeError": {
      "additionalProperties": false,
      "description": "Structured business error metadata carried by machine-readable command envelopes.",
      "properties": {
        "base_generation": {
          "description": "Поколение конфигурации базы; заполняется отказом `non_fast_forward`.",
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "local_generation": {
          "description": "Поколение, записанное после прошлого обмена; заполняется тем же отказом.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStep"
            },
            {
              "type": "null"
            }
          ],
          "description": "Шаг, которым вызывающий выходит из отказа. Проза остаётся человеку."
        },
        "platform_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlatformReleaseRefusal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Формат исходников и опись установок; заполняется отказом `platform_release_missing`."
        }
      },
      "required": [
        "code",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Код отказа — та же причина подробнее. Набор закрыт вместе с родом.",
      "oneOf": [
        {
          "enum": [
            "capability_unavailable",
            "environment_unavailable",
            "workspace_busy",
            "invalid_output",
            "cancelled",
            "timed_out",
            "invalid_argument",
            "unsupported_value",
            "runtime_failure",
            "platform_failure"
          ],
          "type": "string"
        },
        {
          "const": "subject",
          "description": "Предмет не тот, и другим он не станет.",
          "type": "string"
        },
        {
          "const": "target",
          "description": "Не для этой цели.",
          "type": "string"
        },
        {
          "const": "soon",
          "description": "Пока не умеет.",
          "type": "string"
        },
        {
          "const": "platform_release_missing",
          "description": "Пара к роду `environment`: при `tools.platform.version: sources` выпуска, который пишет\nформат исходников, среди установок нет.",
          "type": "string"
        },
        {
          "const": "infobase_busy",
          "description": "Файловую базу держит другая команда; как `workspace_busy`, можно повторить.",
          "type": "string"
        },
        {
          "const": "non_fast_forward",
          "description": "Пара к роду `non_fast_forward`: база ушла вперёд записанного поколения.",
          "type": "string"
        },
        {
          "const": "untracked_base",
          "description": "Пара к роду `untracked_base`: памяти о базе нет.",
          "type": "string"
        },
        {
          "const": "agent_limit",
          "description": "`agent hold`: живых агентов уже `live-max`, и снять некого.",
          "type": "string"
        },
        {
          "const": "live_agent_off",
          "description": "`agent hold` при `tools.designer_agent.live: false`.",
          "type": "string"
        },
        {
          "const": "live_agent_job",
          "description": "`agent hold` в Job, из которого сторож не может выйти.",
          "type": "string"
        }
      ]
    },
    "ErrorKind": {
      "description": "Род отказа. Набор закрыт: новый род приходит вместе с версией конверта, а не молча.",
      "oneOf": [
        {
          "enum": [
            "capability",
            "environment",
            "workspace",
            "invalid_output",
            "interruption",
            "validation",
            "runtime",
            "platform"
          ],
          "type": "string"
        },
        {
          "const": "non_fast_forward",
          "description": "Отправка в базу, ушедшую вперёд записанного поколения.",
          "type": "string"
        },
        {
          "const": "untracked_base",
          "description": "Отправка в базу, о которой у рабочей копии нет памяти.",
          "type": "string"
        }
      ]
    },
    "ExecutionError": {
      "additionalProperties": false,
      "description": "Structured execution error that can point to related artifacts.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExecutionStepKind": {
      "description": "Stable pipeline vocabulary for significant execution blocks.",
      "enum": [
        "validation",
        "resolve_target",
        "prepare_workspace",
        "platform_command",
        "parse_output",
        "publish",
        "cleanup",
        "diagnostics",
        "other"
      ],
      "type": "string"
    },
    "ExecutionStepStatus": {
      "description": "Richer step status beyond the legacy boolean `ok`.",
      "enum": [
        "succeeded",
        "failed",
        "skipped",
        "degraded"
      ],
      "type": "string"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/WireExecutorKind"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Frame": {
      "description": "One closed output type owns both serialization and the generated wire schema.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "executor": {
              "$ref": "#/$defs/Executor"
            },
            "nonce": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "phase": {
              "const": "selected",
              "type": "string"
            },
            "provider": {
              "$ref": "#/$defs/ProviderReceipt"
            },
            "version": {
              "format": "uint32",
              "maximum": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "phase",
            "version",
            "nonce",
            "provider",
            "executor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "extension": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "$ref": "#/$defs/ReportedDumpMode"
            },
            "mode_reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DumpModeReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nonce": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "phase": {
              "const": "ready",
              "type": "string"
            },
            "provider_dispatched": {
              "type": "boolean"
            },
            "requested_mode": {
              "$ref": "#/$defs/DumpMode"
            },
            "snapshot": {
              "$ref": "#/$defs/Snapshot"
            },
            "snapshot_warning": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_set": {
              "type": "string"
            },
            "stage_path": {
              "type": "string"
            },
            "target_path": {
              "type": "string"
            },
            "version": {
              "format": "uint32",
              "maximum": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "phase",
            "version",
            "nonce",
            "command",
            "requested_mode",
            "mode",
            "provider_dispatched",
            "source_set",
            "target_path",
            "stage_path",
            "snapshot"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "memory": {
              "$ref": "#/$defs/Memory"
            },
            "nonce": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "phase": {
              "const": "terminal",
              "type": "string"
            },
            "publication": {
              "$ref": "#/$defs/Publication"
            },
            "result": {
              "$ref": "#/$defs/Envelope"
            },
            "version": {
              "format": "uint32",
              "maximum": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "phase",
            "version",
            "nonce",
            "publication",
            "memory",
            "result"
          ],
          "type": "object"
        }
      ]
    },
    "InstalledComponents": {
      "additionalProperties": false,
      "description": "Какие компоненты есть в установке.",
      "properties": {
        "designer": {
          "description": "Конфигуратор и толстый клиент (`1cv8`).",
          "type": "boolean"
        },
        "ibcmd": {
          "description": "Автономный сервер (`ibcmd`).",
          "type": "boolean"
        },
        "thin_client": {
          "description": "Тонкий клиент (`1cv8c`).",
          "type": "boolean"
        },
        "web_extension": {
          "description": "Расширение веб-сервера (`webinst`).",
          "type": "boolean"
        }
      },
      "required": [
        "designer",
        "thin_client",
        "ibcmd",
        "web_extension"
      ],
      "type": "object"
    },
    "LiveAgentHolder": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Держатель-процесс: номер и время старта (UTC, RFC 3339), если система его назвала.",
          "properties": {
            "pid": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "pid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Держатель со сроком: до какого мгновения (UTC, RFC 3339).",
          "properties": {
            "until": {
              "type": "string"
            }
          },
          "required": [
            "until"
          ],
          "type": "object"
        }
      ],
      "description": "Держатель живого агента в квитанции."
    },
    "LiveAgentReason": {
      "description": "Почему управляемый агент не остался жить после команды.",
      "oneOf": [
        {
          "const": "live_agent_off",
          "description": "`tools.designer_agent.live: false`.",
          "type": "string"
        },
        {
          "const": "limit",
          "description": "Живых агентов уже `tools.designer_agent.live-max`, и снять простаивающего некого.",
          "type": "string"
        },
        {
          "const": "job",
          "description": "Раннер в Job, из которого сторож не может выйти.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "Команду прервали, пока агент выполнял её запрос.",
          "type": "string"
        },
        {
          "const": "busy",
          "description": "Живой агент этой рабочей копии ещё служит сессии другой команды: команда работала с\nразовым.",
          "type": "string"
        },
        {
          "const": "keeper_failed",
          "description": "Сторож живого агента не поднялся или не ответил (путь канала, отказ запуска, срок):\nкоманда работала с разовым агентом.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "Сторож снял агента после команды: его сессия оборвалась, его остановили или ушёл\nпоследний держатель.",
          "type": "string"
        }
      ]
    },
    "LiveAgentReceipt": {
      "additionalProperties": false,
      "description": "Живой ли был управляемый агент команды и остался ли он жить.",
      "properties": {
        "holders": {
          "description": "Держатели агента на момент ответа; без держателей — пустой список.",
          "items": {
            "$ref": "#/$defs/LiveAgentHolder"
          },
          "type": "array"
        },
        "kept": {
          "description": "Остался ли агент жить после команды.",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveAgentReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Почему агент не остался жить; у оставшегося поля нет."
        },
        "reused": {
          "description": "Команда взяла уже живого агента (`true`) или подняла его сама (`false`).",
          "type": "boolean"
        }
      },
      "required": [
        "reused",
        "holders",
        "kept"
      ],
      "type": "object"
    },
    "Memory": {
      "enum": [
        "unchanged",
        "saved",
        "not_saved"
      ],
      "type": "string"
    },
    "NextStep": {
      "additionalProperties": false,
      "description": "Шаг, которым вызывающий выходит из отказа: команда, при нужде набор исходников и ключи.\n\nПоле отвечает машине; человеку остаётся текст сообщения, и он не сокращается.",
      "properties": {
        "command": {
          "description": "Имя команды словаря, как его печатает конверт: `launch web`, `pull`, `init`.",
          "type": "string"
        },
        "keys": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ключи команды со значениями: `--mode` → `combine`.",
          "type": "object"
        },
        "source_set": {
          "description": "Набор исходников, когда шаг относится к одному набору.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "OperationSize": {
      "description": "Объём операции, по которому раннер упорядочивает цепочку умолчаний (#559).\n\nИмя идёт в квитанцию полем `reason`: им раннер объясняет, почему первым в цепочке стоит\nтот, кто стоит.",
      "oneOf": [
        {
          "const": "whole",
          "description": "Каждый набор, который команда загружает или выгружает, идёт целиком.",
          "type": "string"
        },
        {
          "const": "by_changes",
          "description": "Хотя бы один набор идёт по изменившемуся или выборкой.",
          "type": "string"
        }
      ]
    },
    "PlatformInstallation": {
      "additionalProperties": false,
      "description": "Установка платформы: версия, каталог и состав.",
      "properties": {
        "components": {
          "$ref": "#/$defs/InstalledComponents"
        },
        "root": {
          "description": "Каталог версии.",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "root",
        "components"
      ],
      "type": "object"
    },
    "PlatformReleaseRefusal": {
      "additionalProperties": false,
      "description": "Отказ `platform_release_missing`: при `tools.platform.version: sources` выпуска, который\nпишет формат исходников, среди установок нет. Установки — те, по которым решён отказ.",
      "properties": {
        "installations": {
          "description": "Установки, среди которых выпуска не нашлось, новейшие первыми.",
          "items": {
            "$ref": "#/$defs/PlatformInstallation"
          },
          "type": "array"
        },
        "source_format": {
          "$ref": "#/$defs/SourceFormatInfo",
          "description": "Формат исходников основного набора и выпуск, который его пишет; `release` — `null`,\nесли раннер такого выпуска не знает, `version` — `null`, если формат не прочитан."
        }
      },
      "required": [
        "source_format",
        "installations"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Точка входа сессии агента, через которую шло исполнение. Нет — сессия не\nоткрывалась: исполнял процесс платформы, это превью или отказ до подключения."
        },
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationSize"
            },
            {
              "type": "null"
            }
          ],
          "description": "Почему цепочка умолчаний стоит в этом порядке: объём операции. Есть только у\nумолчания, которое раннер упорядочил по объёму (`push` и `pull` файловой базы);\nу ключа `providers.*` и у остальных цепочек поля нет."
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "Publication": {
      "enum": [
        "not_published",
        "published",
        "unknown"
      ],
      "type": "string"
    },
    "PublicationDecision": {
      "enum": [
        "published",
        "rejected"
      ],
      "type": "string"
    },
    "Reply": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "$ref": "#/$defs/SelectionDecision"
            },
            "nonce": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "phase": {
              "const": "selected",
              "type": "string"
            },
            "version": {
              "format": "uint32",
              "maximum": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "phase",
            "version",
            "nonce",
            "decision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "$ref": "#/$defs/PublicationDecision"
            },
            "nonce": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "phase": {
              "const": "ready",
              "type": "string"
            },
            "version": {
              "format": "uint32",
              "maximum": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "phase",
            "version",
            "nonce",
            "decision"
          ],
          "type": "object"
        }
      ]
    },
    "ReportedDumpMode": {
      "description": "Случившийся режим выгрузки в ответе. В отличие от [`DumpMode`] знает «неизвестен»:\nпрогноз `ibcmd` не распознан или не получен либо каталог после выгрузки не перечислен, и\nобещать «по изменившемуся» нельзя.\nПлана с таким режимом не бывает, поэтому значение живёт только в ответе.",
      "enum": [
        "FULL",
        "INCREMENTAL",
        "PARTIAL",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "SelectionDecision": {
      "enum": [
        "continue",
        "reject"
      ],
      "type": "string"
    },
    "SessionEndpoint": {
      "additionalProperties": false,
      "description": "Точка входа открытой сессии: режим и `host:port`, к которому раннер подключился.\n\nАдрес строится из разобранных хоста и порта, а не из записи конфига, поэтому\nучётных данных в нём нет: ни `user:pass@`, ни пароля строки соединения.",
      "properties": {
        "address": {
          "type": "string"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveAgentReceipt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Был ли управляемый агент живым (`INV.WIRE.A-RECEIPT-SAYS-WHETHER-THE-AGENT-WAS-LIVE`).\nЕсть только у управляемого агента."
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        }
      },
      "required": [
        "mode",
        "address"
      ],
      "type": "object"
    },
    "SessionMode": {
      "description": "Как раннер добрался до точки входа агента.",
      "oneOf": [
        {
          "const": "managed",
          "description": "Агента Конфигуратора поднял сам раннер.",
          "type": "string"
        },
        {
          "const": "attached",
          "description": "Агент Конфигуратора поднят не раннером, раннер к нему подключился.",
          "type": "string"
        },
        {
          "const": "gate",
          "description": "SSH-шлюз автономного сервера.",
          "type": "string"
        }
      ]
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    },
    "Snapshot": {
      "enum": [
        "prepared",
        "unavailable"
      ],
      "type": "string"
    },
    "SourceFormatInfo": {
      "additionalProperties": false,
      "description": "Формат исходников проекта.",
      "properties": {
        "file": {
          "description": "Прочитанный `Configuration.xml`.",
          "type": "string"
        },
        "release": {
          "description": "Выпуск платформы, который пишет этот формат; `null`, если раннер такого не знает.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Версия формата; `null`, если файл есть, а версии в его корне нет.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "description": "A transport-neutral execution step shared by CLI envelopes and use-case payloads.",
      "properties": {
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSet"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ExecutionError"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ExecutionStepKind"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStepStatus"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "ok",
        "status",
        "kind",
        "duration_ms"
      ],
      "type": "object"
    },
    "WireExecutorKind": {
      "enum": [
        "local",
        "attached",
        "remote"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/full-pull-publication.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Frame"
    },
    {
      "$ref": "#/$defs/Reply"
    }
  ],
  "title": "v8-runner external full-pull publication protocol"
}
