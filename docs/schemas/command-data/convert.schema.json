{
  "$defs": {
    "ConvertDirection": {
      "description": "Направление перевода: откуда и куда. Направления с пакетом исполняет цепочка строки\n`convert` матрицы, направления между EDT и XML — `1cedtcli`.",
      "oneOf": [
        {
          "enum": [
            "EDT_TO_DESIGNER",
            "DESIGNER_TO_EDT"
          ],
          "type": "string"
        },
        {
          "const": "DESIGNER_TO_PACKAGE",
          "description": "Наборы XML платформы — в пакеты `.cf` и `.cfe`.",
          "type": "string"
        },
        {
          "const": "EDT_TO_PACKAGE",
          "description": "Наборы проекта EDT — в пакеты: сперва `1cedtcli` переводит их в XML.",
          "type": "string"
        },
        {
          "const": "PACKAGE_TO_DESIGNER",
          "description": "Файл пакета `.cf` или `.cfe` — в XML платформы.",
          "type": "string"
        }
      ]
    },
    "ConvertOutput": {
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_set": {
          "description": "Набор, который переведён; нет — на входе был файл пакета.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_path": {
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "target_path"
      ],
      "type": "object"
    },
    "ConvertScope": {
      "oneOf": [
        {
          "enum": [
            "ALL",
            "SINGLE"
          ],
          "type": "string"
        },
        {
          "const": "PACKAGE",
          "description": "Позиционный аргумент назвал файл пакета, а не набор.",
          "type": "string"
        }
      ]
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Точка входа сессии агента, через которую шло исполнение. Нет — сессия не\nоткрывалась: исполнял процесс платформы, это превью или отказ до подключения."
        },
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SessionEndpoint": {
      "additionalProperties": false,
      "description": "Точка входа открытой сессии: режим и `host:port`, к которому раннер подключился.\n\nАдрес строится из разобранных хоста и порта, а не из записи конфига, поэтому\nучётных данных в нём нет: ни `user:pass@`, ни пароля строки соединения.",
      "properties": {
        "address": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        }
      },
      "required": [
        "mode",
        "address"
      ],
      "type": "object"
    },
    "SessionMode": {
      "description": "Как раннер добрался до точки входа агента.",
      "oneOf": [
        {
          "const": "managed",
          "description": "Агента Конфигуратора поднял сам раннер.",
          "type": "string"
        },
        {
          "const": "attached",
          "description": "Агент Конфигуратора поднят не раннером, раннер к нему подключился.",
          "type": "string"
        },
        {
          "const": "gate",
          "description": "SSH-шлюз автономного сервера.",
          "type": "string"
        }
      ]
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/convert.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "direction": {
      "$ref": "#/$defs/ConvertDirection"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/ConvertOutput"
      },
      "type": "array"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Выбор исполнителя направления с пакетом; у перевода между EDT и XML выбора нет."
    },
    "provider_dispatched": {
      "description": "Whether an executor got this command's work: a process of the EDT CLI or of `ibcmd` was\nstarted to do it, or the request's command was handed to a running EDT session.\nStarting the session and its own service commands are not work. `false` whenever it got\nnone — a preview, a refusal or interruption before any work, or a process that could\nnot be started.\n\nAlways present, so an absent field never has to be read as \"no work was given\". In a\npreview `outputs` names what would be written.",
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/ConvertScope"
    },
    "source_set": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_path": {
      "description": "Рабочая область EDT; нет — направление обходится без `1cedtcli`.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "direction",
    "scope",
    "outputs",
    "duration_ms"
  ],
  "title": "ConvertResult",
  "type": "object"
}
