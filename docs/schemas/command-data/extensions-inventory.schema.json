{
  "$defs": {
    "InstalledExtension": {
      "additionalProperties": false,
      "description": "One extension installed in the target infobase, as reported by the platform.\n\nField set mirrors `ibcmd config extension list` on 8.3.27 exactly. The name\nprefix is deliberately absent: the platform does not report it on read, it lives\nonly in the extension's own `Configuration.xml`.",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "hash_sum": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "safe_mode": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        },
        "security_profile_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "unsafe_action_protection": {
          "type": "boolean"
        },
        "used_in_distributed_infobase": {
          "type": "boolean"
        },
        "version": {
          "description": "`None` when the platform reported the field empty.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "active",
        "purpose",
        "safe_mode",
        "unsafe_action_protection",
        "used_in_distributed_infobase",
        "scope",
        "hash_sum"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/extensions-inventory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result of reading the extension composition of an infobase.",
  "properties": {
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "extensions": {
      "description": "Extensions in the order the platform reported them.\n\nThat order is not the creation order and the platform does not document one,\nso callers must not rely on it.",
      "items": {
        "$ref": "#/$defs/InstalledExtension"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "plan": {
      "description": "What the apply would do, named without any secret from the connection string.",
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "`false` when the run stopped at a preview instead of dispatching the platform.\n\nReading the composition is an action, not a look: the platform starts, a session\nopens, the account authenticates and a journal trace is left. So the read has a\npreview too, and in it `extensions` is empty because nothing was asked.",
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "extensions",
    "duration_ms"
  ],
  "title": "ExtensionInventoryResult",
  "type": "object"
}
