{
  "$defs": {
    "DebugServerAction": {
      "description": "Что сделала команда `debug-server stop`.",
      "oneOf": [
        {
          "const": "stopped",
          "description": "`stop`: свой `dbgs` сеанса остановлен.",
          "type": "string"
        },
        {
          "const": "released",
          "description": "`stop`: одна lease освобождена, остальные ещё используют процесс.",
          "type": "string"
        },
        {
          "const": "nothing_to_stop",
          "description": "`stop`: аренда неизвестна или процесс уже завершился.",
          "type": "string"
        },
        {
          "const": "planned",
          "description": "Предварительный просмотр: ничего не запущено и не остановлено.",
          "type": "string"
        }
      ]
    },
    "DebugServerOwner": {
      "description": "Кто поднял сервер отладки и кто его гасит.",
      "oneOf": [
        {
          "const": "runner",
          "description": "`dbgs`, которого поднял раннер для этого сеанса; `stop` его гасит.",
          "type": "string"
        }
      ]
    },
    "DebugSession": {
      "description": "Сеанс сервера отладки: его передают в `debug-server stop`.",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/debug-server-stop.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/DebugServerAction",
      "description": "Исход освобождения аренды."
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "known_session": {
      "description": "`stop`: раннер знает этот сеанс. `false` — записи нет: сеанс уже остановлен или\nзапущен из другой рабочей копии.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/DebugServerOwner"
        },
        {
          "type": "null"
        }
      ]
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/DebugSession"
        },
        {
          "type": "null"
        }
      ],
      "description": "Аренда, переданная в `debug-server stop`."
    },
    "stale_record": {
      "description": "Запись была, но процесса из неё уже нет: сервер вышел сам, например с концом владельца.",
      "type": "boolean"
    },
    "stopped_pid": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "ok",
    "action",
    "duration_ms"
  ],
  "title": "DebugServerResult",
  "type": "object"
}
