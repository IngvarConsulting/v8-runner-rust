{
  "$defs": {
    "DumpMode": {
      "enum": [
        "FULL",
        "INCREMENTAL",
        "PARTIAL"
      ],
      "type": "string"
    },
    "DumpSelectorResult": {
      "additionalProperties": false,
      "properties": {
        "normalized": {
          "type": "string"
        },
        "requested": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "normalized"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/pull.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "extension": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/DumpMode"
    },
    "ok": {
      "type": "boolean"
    },
    "platform_log_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "Получил ли исполнитель работу этой команды: запущен процесс, который её выполняет,\nлибо работающей сессии отдана команда запроса. Подъём и открытие сессии, в том числе\nзапуск её процесса, и её служебные команды работой не считаются. `false`, если работы\nне было: превью, отказ или прерывание до передачи работы, процесс, который не удалось\nзапустить. Поле есть всегда, поэтому отсутствие работы не выводится из отсутствия\nзначения.",
      "type": "boolean"
    },
    "selectors": {
      "items": {
        "$ref": "#/$defs/DumpSelectorResult"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "source_set": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_path": {
      "type": "string"
    },
    "up_to_date": {
      "default": false,
      "description": "`true` when the platform reported the configuration generation unchanged since the\nlast recorded build or dump and nothing was dumped.",
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "mode",
    "target_path",
    "duration_ms"
  ],
  "title": "DumpResult",
  "type": "object"
}
