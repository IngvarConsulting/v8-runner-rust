{
  "$defs": {
    "BuildMode": {
      "oneOf": [
        {
          "enum": [
            "edt_export",
            "full",
            "skipped"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "partial": {
              "additionalProperties": false,
              "properties": {
                "file_count": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "file_count"
              ],
              "type": "object"
            }
          },
          "required": [
            "partial"
          ],
          "type": "object"
        }
      ]
    },
    "BuildStep": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/BuildMode"
        },
        "ok": {
          "type": "boolean"
        },
        "source_set": {
          "type": "string"
        }
      },
      "required": [
        "source_set",
        "mode",
        "ok",
        "duration_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/build.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "provider_dispatched": {
      "description": "`false` when the run stopped at a preview instead of dispatching the platform.\n\nAlways present. In a preview each step's `mode` is the mode that would be used and\nits message says so; the flag is what separates planned from performed.",
      "type": "boolean"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/BuildStep"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "steps",
    "duration_ms"
  ],
  "title": "BuildResult",
  "type": "object"
}
