{
  "$defs": {
    "InitSource": {
      "additionalProperties": false,
      "description": "База-источник копии и снимок, из которого создана новая база.",
      "properties": {
        "infobase": {
          "description": "Имя базы-источника в местном слое.",
          "type": "string"
        },
        "snapshot": {
          "description": "Абсолютный путь образа DT под `workPath`, снятого с источника; под превью — путь,\nкуда он лёг бы.",
          "type": "string"
        }
      },
      "required": [
        "infobase",
        "snapshot"
      ],
      "type": "object"
    },
    "InitStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/InitStepStatus"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "action",
        "status",
        "duration_ms"
      ],
      "type": "object"
    },
    "InitStepStatus": {
      "oneOf": [
        {
          "enum": [
            "ok",
            "skipped",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "planned",
          "description": "The step was decided but not performed, because the run is a preview.",
          "type": "string"
        }
      ]
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Точка входа сессии агента, через которую шло исполнение. Нет — сессия не\nоткрывалась: исполнял процесс платформы, это превью или отказ до подключения."
        },
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SessionEndpoint": {
      "additionalProperties": false,
      "description": "Точка входа открытой сессии: режим и `host:port`, к которому раннер подключился.\n\nАдрес строится из разобранных хоста и порта, а не из записи конфига, поэтому\nучётных данных в нём нет: ни `user:pass@`, ни пароля строки соединения.",
      "properties": {
        "address": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        }
      },
      "required": [
        "mode",
        "address"
      ],
      "type": "object"
    },
    "SessionMode": {
      "description": "Как раннер добрался до точки входа агента.",
      "oneOf": [
        {
          "const": "managed",
          "description": "Агента Конфигуратора поднял сам раннер.",
          "type": "string"
        },
        {
          "const": "attached",
          "description": "Агент Конфигуратора поднят не раннером, раннер к нему подключился.",
          "type": "string"
        },
        {
          "const": "gate",
          "description": "SSH-шлюз автономного сервера.",
          "type": "string"
        }
      ]
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/infobase-create.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "Whether an executor got this command's work: a process was started to do it, or the\nrequest's command was handed to a running session. Starting or opening a session and\nits own service commands are not work. `false` whenever the executor got none — a\npreview, a refusal or interruption before any work, a run with nothing to do, or a\nprocess that could not be started.\n\nAlways present, so an absent field never has to be read as \"no work was given\".",
      "type": "boolean"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/InitSource"
        },
        {
          "type": "null"
        }
      ],
      "description": "Источник копии у `infobase create --from`: база, с которой снят образ, и путь снимка.\nБез `--from` поля нет."
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/InitStep"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "steps",
    "duration_ms"
  ],
  "title": "InitResult",
  "type": "object"
}
