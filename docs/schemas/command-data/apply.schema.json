{
  "$defs": {
    "ApplyGeneration": {
      "description": "Запись журнала поколений набора после применения.",
      "oneOf": [
        {
          "const": "recorded",
          "description": "Поколение до применения совпало с записью; после него записано то, что ответил\nинструмент записи, и снят признак «не применено».",
          "type": "string"
        },
        {
          "const": "kept",
          "description": "База ушла от записи до применения: запись не тронута, следующая отправка это назовёт.",
          "type": "string"
        },
        {
          "const": "erased",
          "description": "Инструмент записи не ответил поколением: запись стёрта, и следующая отправка базу не\nсверяет.",
          "type": "string"
        },
        {
          "const": "unchecked",
          "description": "Записи этой пары нет: сверять не с чем.",
          "type": "string"
        },
        {
          "const": "unerased",
          "description": "Инструмент записи не ответил, а стереть запись не удалось: она осталась прежней и\nможет принять это применение за чужую правку; ответ называет причину.",
          "type": "string"
        }
      ]
    },
    "ApplyOutcome": {
      "description": "Исход шага. Удача шага — `applied`, `planned` или `skipped`; отдельного `ok` у шага нет.",
      "oneOf": [
        {
          "const": "applied",
          "description": "Применено.",
          "type": "string"
        },
        {
          "const": "planned",
          "description": "Превью: применилось бы.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Не применяется: внешний набор или расширение, которого нет в базе.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Применение отказало; команда остановилась на этом шаге.",
          "type": "string"
        },
        {
          "const": "not_run",
          "description": "Не запускался: команда остановилась раньше.",
          "type": "string"
        }
      ]
    },
    "ApplyStep": {
      "additionalProperties": false,
      "description": "Один набор исходников (или расширение-инструмент `tool:<имя>`).",
      "properties": {
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplyGeneration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Что стало с записью журнала поколений набора; нет поля — набор не применялся."
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ApplyOutcome"
        },
        "purpose": {
          "$ref": "#/$defs/SourceSetPurpose"
        },
        "source_set": {
          "type": "string"
        }
      },
      "required": [
        "source_set",
        "purpose",
        "outcome",
        "duration_ms"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Точка входа сессии агента, через которую шло исполнение. Нет — сессия не\nоткрывалась: исполнял процесс платформы, это превью или отказ до подключения."
        },
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SessionEndpoint": {
      "additionalProperties": false,
      "description": "Точка входа открытой сессии: режим и `host:port`, к которому раннер подключился.\n\nАдрес строится из разобранных хоста и порта, а не из записи конфига, поэтому\nучётных данных в нём нет: ни `user:pass@`, ни пароля строки соединения.",
      "properties": {
        "address": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        }
      },
      "required": [
        "mode",
        "address"
      ],
      "type": "object"
    },
    "SessionMode": {
      "description": "Как раннер добрался до точки входа агента.",
      "oneOf": [
        {
          "const": "managed",
          "description": "Агента Конфигуратора поднял сам раннер.",
          "type": "string"
        },
        {
          "const": "attached",
          "description": "Агент Конфигуратора поднят не раннером, раннер к нему подключился.",
          "type": "string"
        },
        {
          "const": "gate",
          "description": "SSH-шлюз автономного сервера.",
          "type": "string"
        }
      ]
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    },
    "SourceSetPurpose": {
      "description": "Назначение набора исходников — значение ключа `type` в `v8project.yaml`.",
      "enum": [
        "CONFIGURATION",
        "EXTENSION",
        "EXTERNAL_DATA_PROCESSORS",
        "EXTERNAL_REPORTS"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/apply.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "Получил ли исполнитель работу этой команды\n(`INV.WIRE.PROVIDER-DISPATCHED-SAYS-WHETHER-AN-EXECUTOR-GOT-WORK`). У превью — `false`.",
      "type": "boolean"
    },
    "steps": {
      "description": "Наборы по порядку: конфигурация, расширения, внешние; за ними — расширение-инструмент.",
      "items": {
        "$ref": "#/$defs/ApplyStep"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "steps",
    "duration_ms"
  ],
  "title": "ApplyResult",
  "type": "object"
}
