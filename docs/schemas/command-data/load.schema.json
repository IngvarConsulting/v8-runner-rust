{
  "$defs": {
    "ArtifactBuildMode": {
      "enum": [
        "unknown",
        "configuration_cf",
        "extension_cfe",
        "external_data_processor_epf",
        "external_report_erf"
      ],
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Stable artifact classification for runner/package outputs.",
      "oneOf": [
        {
          "enum": [
            "run_directory",
            "config",
            "package",
            "report",
            "runner_log",
            "platform_log",
            "sentinel"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a single retained artifact.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "ArtifactSet": {
      "additionalProperties": false,
      "description": "A retained artifact collection for a single execution.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "root_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CompatibilityState": {
      "description": "What the compatibility probe established, and nothing more.\n\nThe probe asks the platform to compare the target with its counterpart, and the only part\nof the answer the platform guarantees is whether the comparison ran: exit code zero, and\nexactly then a comparison report appears. Why it did not run is said in prose, and prose is\nnot a contract — see ADR-0029 — so this enum has no variant for a reason.",
      "oneOf": [
        {
          "const": "supported",
          "description": "The comparison ran, so both sides exist: a configuration is on support, an extension\nis installed and comparable.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Proven absent from the infobase, by the infobase's own extension list — keyed output,\nnot a sentence. A first installation is exactly this state; a merge has nothing to\nmerge into.",
          "type": "string"
        },
        {
          "const": "not_established",
          "description": "The comparison did not run, and the runner does not guess why. Never permits a merge,\nnever blocks a first installation.",
          "type": "string"
        },
        {
          "const": "not_probed",
          "description": "Nobody asked. The run is a preview, or the target cannot be named — a configuration\nneeds the vendor configuration's name before the platform will compare it.",
          "type": "string"
        }
      ]
    },
    "ExecutionError": {
      "additionalProperties": false,
      "description": "Structured execution error that can point to related artifacts.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExecutionInterruptionDetails": {
      "additionalProperties": false,
      "description": "Structured interruption metadata for actual or deferred command-boundary interruptions.",
      "properties": {
        "deferred": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ExecutionInterruptionKind"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "deferred"
      ],
      "type": "object"
    },
    "ExecutionInterruptionKind": {
      "description": "Command-level interruption kind preserved in serialized execution results.",
      "enum": [
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    },
    "ExecutionMetrics": {
      "additionalProperties": false,
      "description": "Shared counters emitted by parsers and execution adapters.",
      "properties": {
        "errors": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "extra": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "failed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "skipped",
        "errors"
      ],
      "type": "object"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "description": "Shared execution envelope for runner-like flows.",
      "properties": {
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSet"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ExecutionError"
          },
          "type": "array"
        },
        "interruptions": {
          "items": {
            "$ref": "#/$defs/ExecutionInterruptionDetails"
          },
          "type": "array"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoadExecutionMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ExecutionStatus": {
      "description": "Shared execution status used by runner and package-like flows.",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "invalid_output"
      ],
      "type": "string"
    },
    "LoadExecutionMetadata": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "compatibility_state": {
          "$ref": "#/$defs/CompatibilityState"
        },
        "target_kind": {
          "$ref": "#/$defs/LoadTargetKind"
        },
        "update_db_cfg_ran": {
          "type": "boolean"
        }
      },
      "required": [
        "applied",
        "target_kind",
        "compatibility_state",
        "update_db_cfg_ran"
      ],
      "type": "object"
    },
    "LoadMode": {
      "enum": [
        "load",
        "merge",
        "update"
      ],
      "type": "string"
    },
    "LoadTargetKind": {
      "enum": [
        "unknown",
        "configuration",
        "extension"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/load.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_path": {
      "type": "string"
    },
    "artifact_type": {
      "$ref": "#/$defs/ArtifactBuildMode"
    },
    "compatibility_state": {
      "$ref": "#/$defs/CompatibilityState"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionOutcome"
    },
    "extension": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/LoadMode"
    },
    "ok": {
      "type": "boolean"
    },
    "platform_log_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_dispatched": {
      "description": "`false` when the run stopped at a preview instead of dispatching the platform.",
      "type": "boolean"
    },
    "target_kind": {
      "$ref": "#/$defs/LoadTargetKind"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "mode",
    "artifact_path",
    "artifact_type",
    "target_kind",
    "compatibility_state",
    "duration_ms",
    "execution"
  ],
  "title": "LoadJsonData",
  "type": "object"
}
