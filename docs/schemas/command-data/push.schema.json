{
  "$defs": {
    "BuildMode": {
      "oneOf": [
        {
          "enum": [
            "edt_export",
            "full",
            "skipped"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "partial": {
              "additionalProperties": false,
              "properties": {
                "file_count": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "file_count"
              ],
              "type": "object"
            }
          },
          "required": [
            "partial"
          ],
          "type": "object"
        }
      ]
    },
    "BuildStep": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/BuildMode"
        },
        "ok": {
          "type": "boolean"
        },
        "source_set": {
          "type": "string"
        }
      },
      "required": [
        "source_set",
        "mode",
        "ok",
        "duration_ms"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/push.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "`false` when the run stopped at a preview instead of dispatching the platform.\n\nAlways present. In a preview each step's `mode` is the mode that would be used and\nits message says so; the flag is what separates planned from performed.",
      "type": "boolean"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/BuildStep"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "steps",
    "duration_ms"
  ],
  "title": "BuildResult",
  "type": "object"
}
