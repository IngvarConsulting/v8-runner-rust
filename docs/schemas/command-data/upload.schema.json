{
  "$defs": {
    "ArtifactBuildMode": {
      "enum": [
        "unknown",
        "configuration_cf",
        "extension_cfe",
        "external_data_processor_epf",
        "external_report_erf"
      ],
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Stable artifact classification for runner/package outputs.",
      "oneOf": [
        {
          "enum": [
            "run_directory",
            "config",
            "package",
            "report",
            "runner_log",
            "platform_log",
            "sentinel"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a single retained artifact.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "ArtifactSet": {
      "additionalProperties": false,
      "description": "A retained artifact collection for a single execution.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "root_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CompatibilityState": {
      "description": "What the compatibility probe established, and nothing more.\n\nThe probe asks the platform to compare the target with its counterpart, and the only part\nof the answer the platform guarantees is whether the comparison ran: exit code zero, and\nexactly then a comparison report appears. Why it did not run is said in prose, and prose is\nnot a contract — see INV.PLATFORM.PROSE-DEBT-ONLY-SHRINKS — so this enum has no variant for a reason.",
      "oneOf": [
        {
          "const": "supported",
          "description": "The comparison ran, so both sides exist: a configuration is on support, an extension\nis installed and comparable.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Proven absent from the infobase, by the infobase's own extension list — keyed output,\nnot a sentence. A first installation is exactly this state; a merge has nothing to\nmerge into.",
          "type": "string"
        },
        {
          "const": "not_established",
          "description": "The comparison did not run, and the runner does not guess why. Never permits a merge,\nnever blocks a first installation.",
          "type": "string"
        },
        {
          "const": "not_probed",
          "description": "Nobody asked. The run is a preview, or the target cannot be named — a configuration\nneeds the vendor configuration's name before the platform will compare it.",
          "type": "string"
        }
      ]
    },
    "ExecutionError": {
      "additionalProperties": false,
      "description": "Structured execution error that can point to related artifacts.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExecutionInterruptionDetails": {
      "additionalProperties": false,
      "description": "Structured metadata of an actual or deferred interruption.",
      "properties": {
        "deferred": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ExecutionInterruptionKind"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionInterruptionPhase"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "deferred"
      ],
      "type": "object"
    },
    "ExecutionInterruptionKind": {
      "description": "Command-level interruption kind preserved in serialized execution results.",
      "enum": [
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    },
    "ExecutionInterruptionPhase": {
      "description": "What was interrupted: one closed vocabulary shared by every form that carries an execution\noutcome. Each command uses the values that name its own work.",
      "oneOf": [
        {
          "const": "command_boundary",
          "description": "A safe point of the command: no platform work or publication was cut short.",
          "type": "string"
        },
        {
          "const": "provider_command",
          "description": "The platform command of `download`, `infobase dump` or `infobase restore`: a process of\nits own or a command of an agent session.",
          "type": "string"
        },
        {
          "const": "run",
          "description": "The test run in the 1C client (`test`).",
          "type": "string"
        },
        {
          "const": "apply",
          "description": "Loading or merging the package into the infobase (`upload`).",
          "type": "string"
        },
        {
          "const": "update_db_cfg",
          "description": "Updating the database configuration (`upload`).",
          "type": "string"
        },
        {
          "const": "publication",
          "description": "Publishing the result through a staged copy (`make`, `download`, `infobase dump`).",
          "type": "string"
        },
        {
          "const": "export_or_publication",
          "description": "`make` only: any failure that arrived while an interruption was pending — at the safe\npoint before export, during export or during publication. The answer does not tell which\n(issue #308).",
          "type": "string"
        }
      ]
    },
    "ExecutionMetrics": {
      "additionalProperties": false,
      "description": "Shared counters emitted by parsers and execution adapters.",
      "properties": {
        "errors": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "extra": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "failed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "skipped",
        "errors"
      ],
      "type": "object"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "description": "Shared execution envelope for runner-like flows.",
      "properties": {
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSet"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ExecutionError"
          },
          "type": "array"
        },
        "interruptions": {
          "items": {
            "$ref": "#/$defs/ExecutionInterruptionDetails"
          },
          "type": "array"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoadExecutionMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ExecutionStatus": {
      "description": "Shared execution status used by runner and package-like flows.",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "invalid_output"
      ],
      "type": "string"
    },
    "LoadExecutionMetadata": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "compatibility_state": {
          "$ref": "#/$defs/CompatibilityState"
        },
        "target_kind": {
          "$ref": "#/$defs/LoadTargetKind"
        },
        "update_db_cfg_ran": {
          "type": "boolean"
        }
      },
      "required": [
        "applied",
        "target_kind",
        "compatibility_state",
        "update_db_cfg_ran"
      ],
      "type": "object"
    },
    "LoadMode": {
      "oneOf": [
        {
          "enum": [
            "load",
            "update"
          ],
          "type": "string"
        },
        {
          "const": "combine",
          "description": "Объединение по файлу настроек. Прежнее имя режима — `merge`, оно принимается\nещё один цикл выпуска, а ответ называет режим новым именем.",
          "type": "string"
        }
      ]
    },
    "LoadTargetKind": {
      "enum": [
        "unknown",
        "configuration",
        "extension"
      ],
      "type": "string"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/upload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_path": {
      "type": "string"
    },
    "artifact_type": {
      "$ref": "#/$defs/ArtifactBuildMode"
    },
    "compatibility_state": {
      "$ref": "#/$defs/CompatibilityState"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionOutcome"
    },
    "extension": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/LoadMode"
    },
    "ok": {
      "type": "boolean"
    },
    "platform_log_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "Whether the platform was started at all: `false` when the command stopped before the\nfirst platform call — at a preview, a refusal or an interruption.",
      "type": "boolean"
    },
    "target_kind": {
      "$ref": "#/$defs/LoadTargetKind"
    }
  },
  "required": [
    "ok",
    "provider_dispatched",
    "mode",
    "artifact_path",
    "artifact_type",
    "target_kind",
    "compatibility_state",
    "duration_ms",
    "execution"
  ],
  "title": "LoadJsonData",
  "type": "object"
}
