{
  "$defs": {
    "CheckName": {
      "description": "Чем платформа выполнила проверку. Набор закрыт: прежнее `designer-modules` исчезло\nвместе с отдельным путём `/CheckModules` — режимы проверки модулей выполняет\n`/CheckConfig`.",
      "oneOf": [
        {
          "const": "designer-config",
          "description": "`/CheckConfig` Конфигуратора.",
          "type": "string"
        },
        {
          "const": "edt",
          "description": "Проверка проекта средствами EDT CLI.",
          "type": "string"
        }
      ]
    },
    "Issue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "module",
              "type": "string"
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/IssueSeverity"
            }
          },
          "required": [
            "kind",
            "path",
            "message",
            "severity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "object",
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/IssueSeverity"
            }
          },
          "required": [
            "kind",
            "object",
            "message",
            "severity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": [
                "string",
                "null"
              ]
            },
            "column": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "edt",
              "type": "string"
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/IssueSeverity"
            }
          },
          "required": [
            "kind",
            "path",
            "message",
            "severity"
          ],
          "type": "object"
        }
      ]
    },
    "IssueSeverity": {
      "enum": [
        "ERROR",
        "WARNING",
        "INFO"
      ],
      "type": "string"
    },
    "LiveAgentHolder": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Держатель-процесс: номер и время старта (UTC, RFC 3339), если система его назвала.",
          "properties": {
            "pid": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "pid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Держатель со сроком: до какого мгновения (UTC, RFC 3339).",
          "properties": {
            "until": {
              "type": "string"
            }
          },
          "required": [
            "until"
          ],
          "type": "object"
        }
      ],
      "description": "Держатель живого агента в квитанции."
    },
    "LiveAgentReason": {
      "description": "Почему управляемый агент не остался жить после команды.",
      "oneOf": [
        {
          "const": "live_agent_off",
          "description": "`tools.designer_agent.live: false`.",
          "type": "string"
        },
        {
          "const": "limit",
          "description": "Живых агентов уже `tools.designer_agent.live-max`, и снять простаивающего некого.",
          "type": "string"
        },
        {
          "const": "job",
          "description": "Раннер в Job, из которого сторож не может выйти.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "Команду прервали, пока агент выполнял её запрос.",
          "type": "string"
        },
        {
          "const": "busy",
          "description": "Живой агент этой рабочей копии ещё служит сессии другой команды: команда работала с\nразовым.",
          "type": "string"
        },
        {
          "const": "keeper_failed",
          "description": "Сторож живого агента не поднялся или не ответил (путь канала, отказ запуска, срок):\nкоманда работала с разовым агентом.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "Сторож снял агента после команды: его сессия оборвалась, его остановили или ушёл\nпоследний держатель.",
          "type": "string"
        }
      ]
    },
    "LiveAgentReceipt": {
      "additionalProperties": false,
      "description": "Живой ли был управляемый агент команды и остался ли он жить.",
      "properties": {
        "holders": {
          "description": "Держатели агента на момент ответа; без держателей — пустой список.",
          "items": {
            "$ref": "#/$defs/LiveAgentHolder"
          },
          "type": "array"
        },
        "kept": {
          "description": "Остался ли агент жить после команды.",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveAgentReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Почему агент не остался жить; у оставшегося поля нет."
        },
        "reused": {
          "description": "Команда взяла уже живого агента (`true`) или подняла его сама (`false`).",
          "type": "boolean"
        }
      },
      "required": [
        "reused",
        "holders",
        "kept"
      ],
      "type": "object"
    },
    "OperationSize": {
      "description": "Объём операции, по которому раннер упорядочивает цепочку умолчаний (#559).\n\nИмя идёт в квитанцию полем `reason`: им раннер объясняет, почему первым в цепочке стоит\nтот, кто стоит.",
      "oneOf": [
        {
          "const": "whole",
          "description": "Каждый набор, который команда загружает или выгружает, идёт целиком.",
          "type": "string"
        },
        {
          "const": "by_changes",
          "description": "Хотя бы один набор идёт по изменившемуся или выборкой.",
          "type": "string"
        }
      ]
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Точка входа сессии агента, через которую шло исполнение. Нет — сессия не\nоткрывалась: исполнял процесс платформы, это превью или отказ до подключения."
        },
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationSize"
            },
            {
              "type": "null"
            }
          ],
          "description": "Почему цепочка умолчаний стоит в этом порядке: объём операции. Есть только у\nумолчания, которое раннер упорядочил по объёму (`push` и `pull` файловой базы);\nу ключа `providers.*` и у остальных цепочек поля нет."
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SessionEndpoint": {
      "additionalProperties": false,
      "description": "Точка входа открытой сессии: режим и `host:port`, к которому раннер подключился.\n\nАдрес строится из разобранных хоста и порта, а не из записи конфига, поэтому\nучётных данных в нём нет: ни `user:pass@`, ни пароля строки соединения.",
      "properties": {
        "address": {
          "type": "string"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveAgentReceipt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Был ли управляемый агент живым (`INV.WIRE.A-RECEIPT-SAYS-WHETHER-THE-AGENT-WAS-LIVE`).\nЕсть только у управляемого агента."
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        }
      },
      "required": [
        "mode",
        "address"
      ],
      "type": "object"
    },
    "SessionMode": {
      "description": "Как раннер добрался до точки входа агента.",
      "oneOf": [
        {
          "const": "managed",
          "description": "Агента Конфигуратора поднял сам раннер.",
          "type": "string"
        },
        {
          "const": "attached",
          "description": "Агент Конфигуратора поднят не раннером, раннер к нему подключился.",
          "type": "string"
        },
        {
          "const": "gate",
          "description": "SSH-шлюз автономного сервера.",
          "type": "string"
        }
      ]
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    },
    "SyntaxCheckStatus": {
      "oneOf": [
        {
          "enum": [
            "clean",
            "issues_found",
            "tool_failed"
          ],
          "type": "string"
        },
        {
          "const": "planned",
          "description": "Превью: проверка запланирована, но не выполнялась. Остальные три значения —\nприговоры конфигурации, и `clean` из превью был бы приговором выдуманным:\nплатформа конфигурацию не смотрела. Предел знания называется своим значением.",
          "type": "string"
        }
      ]
    },
    "SyntaxIssueSummary": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "info": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "warnings",
        "info"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_name": {
      "$ref": "#/$defs/CheckName"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "exit_code": {
      "format": "int32",
      "type": "integer"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "type": "array"
    },
    "log_read_warning": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "description": "Фраза о предмете. Превью называет ею, что было бы выполнено.",
      "type": [
        "string",
        "null"
      ]
    },
    "platform_log_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "description": "Получил ли исполнитель — платформа или EDT CLI — работу этой команды: запущен\nпроцесс, который её выполняет, либо работающей сессии EDT отдана команда запроса.\nПодъём сессии и её служебные команды работой не считаются. `false`, если работы не\nбыло: превью, отказ или прерывание до передачи работы, процесс, который не удалось\nзапустить.",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/SyntaxCheckStatus"
    },
    "stderr": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/SyntaxIssueSummary"
    }
  },
  "required": [
    "provider_dispatched",
    "status",
    "exit_code",
    "check_name",
    "issues",
    "summary",
    "duration_ms"
  ],
  "title": "SyntaxCheckResult",
  "type": "object"
}
