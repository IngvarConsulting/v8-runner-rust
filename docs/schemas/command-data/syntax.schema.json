{
  "$defs": {
    "Issue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "module",
              "type": "string"
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/IssueSeverity"
            }
          },
          "required": [
            "kind",
            "path",
            "message",
            "severity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "object",
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/IssueSeverity"
            }
          },
          "required": [
            "kind",
            "object",
            "message",
            "severity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": [
                "string",
                "null"
              ]
            },
            "column": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "edt",
              "type": "string"
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "severity": {
              "$ref": "#/$defs/IssueSeverity"
            }
          },
          "required": [
            "kind",
            "path",
            "message",
            "severity"
          ],
          "type": "object"
        }
      ]
    },
    "IssueSeverity": {
      "enum": [
        "ERROR",
        "WARNING",
        "INFO"
      ],
      "type": "string"
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    },
    "SyntaxCheckStatus": {
      "enum": [
        "clean",
        "issues_found",
        "tool_failed"
      ],
      "type": "string"
    },
    "SyntaxIssueSummary": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "info": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "warnings",
        "info"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/syntax.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_name": {
      "type": "string"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "exit_code": {
      "format": "int32",
      "type": "integer"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "type": "array"
    },
    "log_read_warning": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform_log_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "status": {
      "$ref": "#/$defs/SyntaxCheckStatus"
    },
    "stderr": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/SyntaxIssueSummary"
    }
  },
  "required": [
    "status",
    "exit_code",
    "check_name",
    "issues",
    "summary",
    "duration_ms"
  ],
  "title": "SyntaxCheckResult",
  "type": "object"
}
