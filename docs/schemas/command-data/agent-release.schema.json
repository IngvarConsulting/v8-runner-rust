{
  "$defs": {
    "LiveAgentHolder": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Держатель-процесс: номер и время старта (UTC, RFC 3339), если система его назвала.",
          "properties": {
            "pid": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "pid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Держатель со сроком: до какого мгновения (UTC, RFC 3339).",
          "properties": {
            "until": {
              "type": "string"
            }
          },
          "required": [
            "until"
          ],
          "type": "object"
        }
      ],
      "description": "Держатель живого агента в квитанции."
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/agent-release.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`data` команды `agent release`.",
  "properties": {
    "disconnected": {
      "description": "Отключён ли агент от базы этим `release` (#644): `false` — он не был подключён или занят\nкомандой.",
      "type": "boolean"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "holders": {
      "description": "Держатели после `release`.",
      "items": {
        "$ref": "#/$defs/LiveAgentHolder"
      },
      "type": "array"
    },
    "key": {
      "description": "Ключ живого агента цели проекта; `null`, если живого агента нет.",
      "type": [
        "string",
        "null"
      ]
    },
    "released": {
      "description": "Была ли отметка этого держателя и снята ли она: `false` — снимать было нечего.",
      "type": "boolean"
    }
  },
  "required": [
    "released",
    "holders",
    "disconnected",
    "duration_ms"
  ],
  "title": "AgentReleaseResult",
  "type": "object"
}
