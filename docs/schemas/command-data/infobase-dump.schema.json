{
  "$defs": {
    "ArtifactKind": {
      "description": "Stable artifact classification for runner/package outputs.",
      "oneOf": [
        {
          "enum": [
            "run_directory",
            "config",
            "package",
            "report",
            "runner_log",
            "platform_log",
            "sentinel"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a single retained artifact.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "ArtifactSet": {
      "additionalProperties": false,
      "description": "A retained artifact collection for a single execution.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "root_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ExecutionError": {
      "additionalProperties": false,
      "description": "Structured execution error that can point to related artifacts.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExecutionInterruptionDetails": {
      "additionalProperties": false,
      "description": "Structured interruption metadata for actual or deferred command-boundary interruptions.",
      "properties": {
        "deferred": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ExecutionInterruptionKind"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "deferred"
      ],
      "type": "object"
    },
    "ExecutionInterruptionKind": {
      "description": "Command-level interruption kind preserved in serialized execution results.",
      "enum": [
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    },
    "ExecutionMetrics": {
      "additionalProperties": false,
      "description": "Shared counters emitted by parsers and execution adapters.",
      "properties": {
        "errors": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "extra": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "failed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "skipped",
        "errors"
      ],
      "type": "object"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "description": "Shared execution envelope for runner-like flows.",
      "properties": {
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSet"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ExecutionError"
          },
          "type": "array"
        },
        "interruptions": {
          "items": {
            "$ref": "#/$defs/ExecutionInterruptionDetails"
          },
          "type": "array"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "null"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ExecutionStatus": {
      "description": "Shared execution status used by runner and package-like flows.",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "invalid_output"
      ],
      "type": "string"
    },
    "ExportTargetState": {
      "description": "Observable state of the final output path after an export attempt.",
      "enum": [
        "unchanged",
        "created",
        "replaced",
        "restored",
        "uncertain"
      ],
      "type": "string"
    },
    "InfobaseExportArtifactKind": {
      "description": "Closed file format vocabulary for information-base exports.\n\nThis type is deliberately namespaced: [`crate::domain::artifact::ArtifactKind`]\nclassifies retained execution artifacts and does not distinguish CF, CFE,\nand DT package formats.",
      "enum": [
        "cf",
        "cfe",
        "dt"
      ],
      "type": "string"
    },
    "InfobaseExportMode": {
      "description": "Whether the command only proves its execution plan or applies it.",
      "enum": [
        "preview",
        "apply"
      ],
      "type": "string"
    },
    "InfobaseExportPlan": {
      "additionalProperties": false,
      "description": "Compact machine-facing plan produced by a non-executing preflight.",
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/InfobaseExportArtifactKind"
        },
        "output": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        }
      },
      "required": [
        "provider",
        "artifact_kind",
        "output"
      ],
      "type": "object"
    },
    "InfobaseSnapshotSubject": {
      "description": "Subject marker for a complete DT export.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "infobase",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Provider": {
      "description": "Исполнитель. Имя называет того, кто делает работу, а не способ его запуска.",
      "oneOf": [
        {
          "const": "designer",
          "description": "Конфигуратор пакетным процессом на операцию.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "Агентский shell: Конфигуратор в агентском режиме или шлюз автономного сервера.",
          "type": "string"
        },
        {
          "const": "ibcmd",
          "description": "Утилита `ibcmd`.",
          "type": "string"
        },
        {
          "const": "ibcmd-rs",
          "description": "Конвертер XML ↔ CF без платформы.",
          "type": "string"
        },
        {
          "const": "webinst",
          "description": "Публикация базы на веб-сервере.",
          "type": "string"
        }
      ]
    },
    "ProviderOrigin": {
      "description": "Откуда взялся выбранный исполнитель.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Первый готовый из цепочки умолчаний.",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Назначен ключом `providers.<операция>` в названном файле.",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "const": "override",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "description": "Квитанция о выборе исполнителя — одна форма у всех операций.\n\nОбъясняет принятое решение и не предлагает другого: неиспользованные альтернативы\nне перечисляются, потому что выбор вызывающему не принадлежит. `selected: null`\nзначит, что выбор состоялся и никто не подошёл: каждый пропущенный назван с причиной.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ProviderOrigin"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedProvider"
          },
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "SkippedProvider": {
      "additionalProperties": false,
      "description": "Исполнитель, пропущенный до выбранного, и почему.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-data/infobase-dump.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed presentation data for an information-base snapshot export.",
  "properties": {
    "artifact_kind": {
      "$ref": "#/$defs/InfobaseExportArtifactKind"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionOutcome"
    },
    "mode": {
      "$ref": "#/$defs/InfobaseExportMode"
    },
    "output": {
      "type": "string"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/InfobaseExportPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Квитанция о выборе исполнителя; `None`, пока выбор не начинался."
    },
    "provider_dispatched": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "published": {
      "type": "boolean"
    },
    "subject": {
      "$ref": "#/$defs/InfobaseSnapshotSubject"
    },
    "target_state": {
      "$ref": "#/$defs/ExportTargetState"
    }
  },
  "required": [
    "mode",
    "subject",
    "artifact_kind",
    "output",
    "published",
    "target_state",
    "execution"
  ],
  "title": "ExportInfobaseSnapshotResult",
  "type": "object"
}
