{
  "$defs": {
    "DesignerAgentSchema": {
      "additionalProperties": false,
      "properties": {
        "attach": {
          "description": "`host:port` of a Designer agent started outside the runner (attached mode). Excludes `port` and `host-key`.",
          "type": [
            "string",
            "null"
          ]
        },
        "base-dir": {
          "description": "`AgentBaseDir` of the attached agent: where its commands read and write files. Needs `attach`.",
          "type": [
            "string",
            "null"
          ]
        },
        "host-fingerprint": {
          "description": "SHA256 fingerprint the attached agent must present, as `SHA256:<base64>`. Attached mode only.",
          "type": "string"
        },
        "host-key": {
          "description": "Private host key file for the runner-launched agent. Absent: the platform generates one (`/AgentSSHHostKeyAuto`).",
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "description": "Port the runner-launched agent listens on (managed mode). Default 1543.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "startup_timeout_ms": {
          "description": "Time limit for the runner-launched agent to accept the first authenticated session, in milliseconds.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "EdtCliSchema": {
      "additionalProperties": false,
      "properties": {
        "auto-start": {
          "description": "Eagerly prewarm the shared EDT session on MCP server startup.",
          "type": "boolean"
        },
        "command_timeout_ms": {
          "description": "Default timeout for interactive EDT commands, in milliseconds.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "interactive-mode": {
          "description": "Use long-lived interactive `1cedtcli` processes instead of one-shot invocations.",
          "type": "boolean"
        },
        "path": {
          "description": "Path to `1cedtcli`, EDT installation root, or version-like discovery hint.",
          "type": [
            "string",
            "null"
          ]
        },
        "startup_timeout_ms": {
          "description": "Time limit for EDT startup until the prompt is ready, in milliseconds.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "version": {
          "description": "Optional EDT version hint used for auto-discovery.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EnterpriseToolSchema": {
      "additionalProperties": false,
      "properties": {
        "additional-launch-keys": {
          "description": "Additional command-line keys appended to enterprise client launches.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ExecutionTimeoutsSchema": {
      "additionalProperties": false,
      "properties": {
        "run_ms": {
          "description": "Main execution timeout in milliseconds.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "startup_ms": {
          "description": "Startup timeout in milliseconds.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_ms": {
          "description": "Total execution timeout in milliseconds.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InfobaseClusterAgentSchema": {
      "additionalProperties": false,
      "description": "The central server agent of the cluster and its administrator.",
      "properties": {
        "address": {
          "description": "Agent address as `host[:port]` when it differs from the host of `Srvr=` with the\nplatform default port (1540); the runner's own `ras` connects to it.",
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "description": "Central server administrator password.",
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "description": "Central server administrator name; no runner operation asks for it by itself.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InfobaseClusterSchema": {
      "additionalProperties": false,
      "description": "The cluster section of a server infobase: three credential levels lie side by side in\nthe local layer, the infobase user in the infobase section itself.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseClusterAgentSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "The central server agent (`ragent`) and its administrator."
        },
        "password": {
          "description": "Cluster administrator password.",
          "type": [
            "string",
            "null"
          ]
        },
        "ras": {
          "description": "Administration server (`ras`) address as `host[:port]` — an IPv6 address in\nbrackets. It goes to `rac` as is, so the port default (1545) stays with the platform.",
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "description": "Cluster administrator name; `sessions` (#212) and `infobase create` in a cluster (#204)\nwill ask for it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InfobaseDbmsSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "DBMS kind passed to `ibcmd --dbms`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Physical database name passed to `ibcmd --database-name`.",
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "description": "Optional DBMS password passed to `ibcmd --database-password`.",
          "type": [
            "string",
            "null"
          ]
        },
        "server": {
          "description": "DBMS server passed to `ibcmd --database-server`.",
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "description": "Optional DBMS user passed to `ibcmd --database-user`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InfobaseSchema": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseClusterSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "The cluster around a server infobase: the administration server (`ras`) address and\nthe two administrator levels above the infobase user — cluster and central server.\nEach operation asks only for the level it needs; a file infobase and a standalone\nserver have no cluster and refuse the section."
        },
        "connection": {
          "default": "",
          "description": "1C infobase connection string without embedded user or password: `File=…` for a file\ninfobase, `Srvr=…;Ref=…` for a cluster; next to `standalone` it is the server's direct\ngate address or empty.",
          "type": "string"
        },
        "dbms": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseDbmsSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional DBMS settings for server-based infobases."
        },
        "password": {
          "description": "Optional infobase password passed to platform utilities.",
          "type": [
            "string",
            "null"
          ]
        },
        "standalone": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseStandaloneSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Standalone server reached through its SSH gate; declares the target kind."
        },
        "user": {
          "description": "Optional infobase user name passed to platform utilities.",
          "type": [
            "string",
            "null"
          ]
        },
        "web": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseWebSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Client address and web-server publication settings."
        }
      },
      "type": "object"
    },
    "InfobaseStandaloneExchangeChannelSchema": {
      "description": "Named exchange channels.",
      "enum": [
        "sftp"
      ],
      "type": "string"
    },
    "InfobaseStandaloneExchangeSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/InfobaseStandaloneExchangeChannelSchema",
          "description": "A named channel: `sftp` — the SFTP subsystem of the gate's SSH connection."
        },
        {
          "description": "The gate user's directory (`<users-data>/<user>` of `ibsrv`) as the runner sees it.",
          "properties": {
            "dir": {
              "description": "The gate user's directory as the runner sees it.",
              "type": "string"
            }
          },
          "required": [
            "dir"
          ],
          "type": "object"
        }
      ],
      "description": "The declared file channel to a standalone server."
    },
    "InfobaseStandaloneSchema": {
      "additionalProperties": false,
      "description": "A standalone server (`ibsrv`) as the target.",
      "properties": {
        "exchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseStandaloneExchangeSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "How files travel between the runner and the gate user's directory: `sftp` through\nthe gate, or `{ dir: … }` — that directory as the runner sees it."
        },
        "gate": {
          "description": "`host:port` of the server's SSH gate (`ibsrv --enable-ssh-gate`, port 1543 by default).",
          "type": "string"
        },
        "host-fingerprint": {
          "description": "SHA256 fingerprint the gate must present, as `SHA256:<base64>`.",
          "type": "string"
        }
      },
      "required": [
        "gate"
      ],
      "type": "object"
    },
    "InfobaseWebSchema": {
      "additionalProperties": false,
      "description": "Publication and client-address settings for the target infobase.",
      "properties": {
        "conf": {
          "description": "Web server configuration file (`webinst -confpath`); required for apache2 and apache22.",
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "description": "Physical directory the publication is written to (`webinst -dir`); must exist.",
          "type": [
            "string",
            "null"
          ]
        },
        "os-auth": {
          "description": "Use OS authentication (`webinst -osauth`); IIS only.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "server": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebServerKindSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Web server to publish on with `v8-runner publish`."
        },
        "url": {
          "description": "Address a client or a browser opens the infobase at; `launch web` uses it.",
          "type": [
            "string",
            "null"
          ]
        },
        "wsdir": {
          "description": "Virtual directory name (`webinst -wsdir`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "McpExecutionSchema": {
      "additionalProperties": false,
      "properties": {
        "admission_timeout_ms": {
          "description": "How long an MCP call may wait for a free execution slot, in milliseconds.\n\nBounds admission only: a call that already holds a slot runs to its terminal outcome.",
          "format": "uint64",
          "maximum": 86400000,
          "minimum": 1,
          "type": "integer"
        },
        "max_concurrent_calls": {
          "description": "Maximum number of MCP calls allowed to execute concurrently.",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "shutdown_grace_period_secs": {
          "description": "Grace period for shutdown drain in seconds.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "McpHttpSchema": {
      "additionalProperties": false,
      "properties": {
        "allowed_hosts": {
          "description": "Host header values the HTTP listener answers besides the loopback.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bind_address": {
          "description": "Socket address for the MCP HTTP listener.",
          "type": "string"
        },
        "idle_ttl_secs": {
          "description": "Idle HTTP session eviction timeout in seconds.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "max_sessions": {
          "description": "Maximum number of tracked HTTP sessions.",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "URL path that serves MCP HTTP requests.",
          "type": "string"
        },
        "stateful_sessions": {
          "description": "Whether MCP HTTP sessions keep state across requests.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "McpSchema": {
      "additionalProperties": false,
      "properties": {
        "execution": {
          "$ref": "#/$defs/McpExecutionSchema",
          "description": "Shared execution limits for MCP calls."
        },
        "http": {
          "$ref": "#/$defs/McpHttpSchema",
          "description": "MCP HTTP transport settings."
        }
      },
      "type": "object"
    },
    "PartialClientMcpToolSchema": {
      "additionalProperties": false,
      "properties": {
        "extension": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialToolExtensionSchema",
              "description": "Machine-local override or reset for the client MCP tool extension."
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-local override or reset for the client MCP tool extension."
        },
        "port": {
          "description": "Machine-local default port passed to onec-client-mcp-devkit.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "wait_ready_timeout_ms": {
          "description": "Machine-local wait-ready timeout in milliseconds.",
          "format": "uint64",
          "maximum": 86400000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PartialToolExtensionSchema": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "allOf": [
              {
                "properties": {
                  "source": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "source"
                ]
              },
              {
                "properties": {
                  "artifact": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "artifact"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "allOf": [
              {
                "properties": {
                  "source": {
                    "type": "null"
                  }
                },
                "required": [
                  "source"
                ]
              },
              {
                "properties": {
                  "artifact": {
                    "type": "null"
                  }
                },
                "required": [
                  "artifact"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolExtensionArtifactSchema",
              "description": "Machine-local artifact-backed `.cfe` extension input or branch-switch reset."
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-local artifact-backed `.cfe` extension input or branch-switch reset."
        },
        "name": {
          "description": "Machine-local extension name override.",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialToolExtensionSourceSchema",
              "description": "Machine-local source-backed extension input or branch-switch reset."
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-local source-backed extension input or branch-switch reset."
        }
      },
      "type": "object"
    },
    "PartialToolExtensionSourceSchema": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceFormatSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-local source format override."
        },
        "path": {
          "description": "Machine-local path override for extension sources.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "PartialToolsSchema": {
      "additionalProperties": false,
      "properties": {
        "client_mcp": {
          "$ref": "#/$defs/PartialClientMcpToolSchema",
          "description": "Machine-local onec-client-mcp tool settings."
        },
        "designer_agent": {
          "$ref": "#/$defs/DesignerAgentSchema",
          "description": "Designer agent endpoint: the agent the runner launches, or one to attach to."
        },
        "edt_cli": {
          "$ref": "#/$defs/EdtCliSchema",
          "description": "Machine-local EDT CLI discovery and execution settings."
        },
        "enterprise": {
          "$ref": "#/$defs/EnterpriseToolSchema",
          "description": "Machine-local enterprise client launch settings."
        },
        "platform": {
          "$ref": "#/$defs/PlatformToolSchema",
          "description": "Machine-local platform executable discovery settings."
        },
        "va": {
          "$ref": "#/$defs/VanessaToolSchema",
          "description": "Machine-local Vanessa Automation tool settings."
        }
      },
      "type": "object"
    },
    "PlatformToolSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Platform binary, installation `bin` directory, or platform root discovery hint. When set, platform discovery uses only this path and never falls back to default roots or PATH.",
          "type": [
            "string",
            "null"
          ]
        },
        "strict": {
          "default": false,
          "description": "Enforce `version` for a configured `path`. Without `path`, `version` is applied to normal default-root and PATH discovery.",
          "type": "boolean"
        },
        "version": {
          "description": "Platform version requirement. Without `path`, it filters normal discovery; with `path`, it is ignored unless `strict` is true.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProviderSchema": {
      "description": "Executors the runner can dispatch to. Names say who does the work, not how it is started.",
      "enum": [
        "designer",
        "agent",
        "ibcmd",
        "ibcmd-rs",
        "webinst"
      ],
      "type": "string"
    },
    "ProvidersSchema": {
      "additionalProperties": false,
      "description": "One optional override per operation that has a choice of executor.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `build`."
        },
        "dump": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `dump`."
        },
        "extensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `extensions`."
        },
        "infobase.configuration.export": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `infobase configuration export`."
        },
        "infobase.dump": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `infobase dump`."
        },
        "infobase.restore": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `infobase restore`."
        },
        "init": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `init`."
        },
        "load": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `load`."
        },
        "make": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `make`."
        },
        "publish": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `publish`. Accepted by the schema so validation can say the operation has no choice."
        },
        "syntax": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSchema"
            },
            {
              "type": "null"
            }
          ],
          "description": "Executor for `syntax`."
        }
      },
      "type": "object"
    },
    "SourceFormatSchema": {
      "enum": [
        "DESIGNER",
        "EDT"
      ],
      "type": "string"
    },
    "TestsSchema": {
      "additionalProperties": false,
      "properties": {
        "execution_timeout_seconds": {
          "description": "Default test execution timeout in seconds.",
          "format": "uint64",
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "va": {
          "$ref": "#/$defs/VanessaTestSchema",
          "description": "Vanessa Automation test runner settings."
        },
        "yaxunit": {
          "$ref": "#/$defs/YaxunitTestSchema",
          "description": "YAxUnit test runner settings."
        }
      },
      "type": "object"
    },
    "ToolExtensionArtifactSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Path to a `.cfe` extension artifact.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "VanessaProfileSchema": {
      "additionalProperties": false,
      "properties": {
        "feature_path": {
          "description": "Feature file or directory used by this Vanessa profile.",
          "type": [
            "string",
            "null"
          ]
        },
        "features_to_run": {
          "description": "Explicit feature files or directories to run.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filter_tags": {
          "description": "Tags included by this Vanessa profile.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ignore_tags": {
          "description": "Tags ignored by this Vanessa profile.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scenario_filter": {
          "description": "Scenario name filters used by this Vanessa profile.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "VanessaTestSchema": {
      "additionalProperties": false,
      "properties": {
        "fail_fast": {
          "description": "Stop the Vanessa test run after the first failure.",
          "type": "boolean"
        },
        "params_path": {
          "description": "Path to generated Vanessa parameters.",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "description": "Vanessa profile name to use by default.",
          "type": [
            "string",
            "null"
          ]
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/VanessaProfileSchema"
          },
          "description": "Named Vanessa profiles available to CLI and MCP test runs.",
          "type": "object"
        },
        "timeouts": {
          "$ref": "#/$defs/ExecutionTimeoutsSchema",
          "description": "Vanessa startup, run, and total timeout overrides."
        }
      },
