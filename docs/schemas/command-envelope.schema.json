{
  "$defs": {
    "ApplicationCode": {
      "description": "Устойчивый код приложения платформы.",
      "oneOf": [
        {
          "const": "Designer",
          "description": "Конфигуратор.",
          "type": "string"
        },
        {
          "const": "1CV8C",
          "description": "Тонкий клиент.",
          "type": "string"
        },
        {
          "const": "1CV8",
          "description": "Толстый клиент.",
          "type": "string"
        },
        {
          "const": "BackgroundJob",
          "description": "Фоновое задание.",
          "type": "string"
        },
        {
          "const": "WebClient",
          "description": "Веб-клиент.",
          "type": "string"
        },
        {
          "const": "COMConnection",
          "description": "Внешнее соединение.",
          "type": "string"
        }
      ]
    },
    "ArtifactKind": {
      "description": "Stable artifact classification for runner/package outputs.",
      "oneOf": [
        {
          "enum": [
            "run_directory",
            "config",
            "package",
            "report",
            "runner_log",
            "platform_log",
            "sentinel"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a single retained artifact.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "ArtifactSet": {
      "additionalProperties": false,
      "description": "A retained artifact collection for a single execution.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "root_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EnvelopeError": {
      "additionalProperties": false,
      "description": "Structured business error metadata carried by machine-readable command envelopes.",
      "properties": {
        "base_generation": {
          "description": "Поколение конфигурации базы; заполняется отказом `non_fast_forward`.",
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "local_generation": {
          "description": "Поколение, записанное после прошлого обмена; заполняется тем же отказом.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStep"
            },
            {
              "type": "null"
            }
          ],
          "description": "Шаг, которым вызывающий выходит из отказа. Проза остаётся человеку."
        },
        "platform_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlatformReleaseRefusal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Формат исходников и опись установок; заполняется отказом `platform_release_missing`."
        },
        "sessions": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfobaseSessions"
            },
            {
              "type": "null"
            }
          ],
          "description": "Кто держит базу; заполняется отказами `infobase_sessions` и `infobase_designer_busy`."
        }
      },
      "required": [
        "code",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Код отказа — та же причина подробнее. Набор закрыт вместе с родом.",
      "oneOf": [
        {
          "enum": [
            "capability_unavailable",
            "environment_unavailable",
            "workspace_busy",
            "invalid_output",
            "cancelled",
            "timed_out",
            "invalid_argument",
            "unsupported_value",
            "runtime_failure",
            "platform_failure"
          ],
          "type": "string"
        },
        {
          "const": "subject",
          "description": "Предмет не тот, и другим он не станет.",
          "type": "string"
        },
        {
          "const": "target",
          "description": "Не для этой цели.",
          "type": "string"
        },
        {
          "const": "soon",
          "description": "Пока не умеет.",
          "type": "string"
        },
        {
          "const": "platform_release_missing",
          "description": "Пара к роду `environment`: при `tools.platform.version: sources` выпуска, который пишет\nформат исходников, среди установок нет.",
          "type": "string"
        },
        {
          "const": "infobase_busy",
          "description": "Файловую базу держит другая команда; как `workspace_busy`, можно повторить.",
          "type": "string"
        },
        {
          "const": "infobase_sessions",
          "description": "Применению нужен монопольный доступ, а базу держат чужие сеансы; кто — в `sessions`.",
          "type": "string"
        },
        {
          "const": "infobase_designer_busy",
          "description": "Файловую базу держит чужой Конфигуратор; его раннер не закрывает.",
          "type": "string"
        },
        {
          "const": "agent_command_abandoned",
          "description": "Род `platform`: второй сигнал бросил ожидание команды чужого агента, и она, возможно,\nещё идёт.",
          "type": "string"
        },
        {
          "const": "non_fast_forward",
          "description": "Пара к роду `non_fast_forward`: база ушла вперёд записанного поколения.",
          "type": "string"
        },
        {
          "const": "untracked_base",
          "description": "Пара к роду `untracked_base`: памяти о базе нет.",
          "type": "string"
        },
        {
          "const": "agent_limit",
          "description": "`agent hold`: живых агентов уже `live-max`, и снять некого.",
          "type": "string"
        },
        {
          "const": "live_agent_off",
          "description": "`agent hold` при `tools.designer_agent.live: false`.",
          "type": "string"
        },
        {
          "const": "live_agent_job",
          "description": "`agent hold` в Job, из которого сторож не может выйти.",
          "type": "string"
        },
        {
          "const": "source_set_ignored_by_git",
          "description": "Правило игнорирования git прячет файл набора; род `validation`.",
          "type": "string"
        }
      ]
    },
    "ErrorKind": {
      "description": "Род отказа. Набор закрыт: новый род приходит вместе с версией конверта, а не молча.",
      "oneOf": [
        {
          "enum": [
            "capability",
            "environment",
            "workspace",
            "invalid_output",
            "interruption",
            "validation",
            "runtime",
            "platform"
          ],
          "type": "string"
        },
        {
          "const": "non_fast_forward",
          "description": "Отправка в базу, ушедшую вперёд записанного поколения.",
          "type": "string"
        },
        {
          "const": "untracked_base",
          "description": "Отправка в базу, о которой у рабочей копии нет памяти.",
          "type": "string"
        }
      ]
    },
    "ExecutionError": {
      "additionalProperties": false,
      "description": "Structured execution error that can point to related artifacts.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExecutionStepKind": {
      "description": "Stable pipeline vocabulary for significant execution blocks.",
      "enum": [
        "validation",
        "resolve_target",
        "prepare_workspace",
        "platform_command",
        "parse_output",
        "publish",
        "cleanup",
        "diagnostics",
        "other"
      ],
      "type": "string"
    },
    "ExecutionStepStatus": {
      "description": "Richer step status beyond the legacy boolean `ok`.",
      "enum": [
        "succeeded",
        "failed",
        "skipped",
        "degraded"
      ],
      "type": "string"
    },
    "InfobaseSessions": {
      "additionalProperties": false,
      "description": "Кто держит базу — поле `error.sessions` отказов `infobase_sessions` и\n`infobase_designer_busy`.",
      "properties": {
        "base": {
          "description": "Строка соединения базы без учётных данных.",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/SessionsEvidence",
          "description": "Откуда известно, что базу держат сеансы."
        },
        "executor_error": {
          "description": "Отказ исполнителя как он есть, когда признак — список сервера (`evidence: server_list`):\nбаза занята, но отказ мог быть и по другой причине. У `executor` — `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "from_this_machine": {
          "description": "Среди сеансов есть сеанс с этой машины.",
          "type": "boolean"
        },
        "list": {
          "description": "Сеансы, как их назвала платформа; `null` — список не получен или не разобран целиком.",
          "items": {
            "$ref": "#/$defs/SessionEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "lock": {
          "$ref": "#/$defs/SessionLock",
          "description": "Блокировка начала сеансов, которая уже стоит у базы."
        },
        "terminable": {
          "description": "Может ли раннер завершить сеансы этой базы для этой команды (`--sessions force`).",
          "type": "boolean"
        }
      },
      "required": [
        "base",
        "from_this_machine",
        "terminable",
        "lock",
        "evidence"
      ],
      "type": "object"
    },
    "InstalledComponents": {
      "additionalProperties": false,
      "description": "Какие компоненты есть в установке.",
      "properties": {
        "designer": {
          "description": "Конфигуратор и толстый клиент (`1cv8`).",
          "type": "boolean"
        },
        "ibcmd": {
          "description": "Автономный сервер (`ibcmd`).",
          "type": "boolean"
        },
        "thin_client": {
          "description": "Тонкий клиент (`1cv8c`).",
          "type": "boolean"
        },
        "web_extension": {
          "description": "Расширение веб-сервера (`webinst`).",
          "type": "boolean"
        }
      },
      "required": [
        "designer",
        "thin_client",
        "ibcmd",
        "web_extension"
      ],
      "type": "object"
    },
    "NextStep": {
      "additionalProperties": false,
      "description": "Шаг, которым вызывающий выходит из отказа: команда, при нужде набор исходников и ключи.\n\nПоле отвечает машине; человеку остаётся текст сообщения, и он не сокращается.",
      "properties": {
        "command": {
          "description": "Имя команды словаря, как его печатает конверт: `launch web`, `pull`, `init`.",
          "type": "string"
        },
        "keys": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ключи команды со значениями: `--mode` → `combine`.",
          "type": "object"
        },
        "source_set": {
          "description": "Набор исходников, когда шаг относится к одному набору.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "PlatformInstallation": {
      "additionalProperties": false,
      "description": "Установка платформы: версия, каталог и состав.",
      "properties": {
        "components": {
          "$ref": "#/$defs/InstalledComponents"
        },
        "root": {
          "description": "Каталог версии.",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "root",
        "components"
      ],
      "type": "object"
    },
    "PlatformReleaseRefusal": {
      "additionalProperties": false,
      "description": "Отказ `platform_release_missing`: при `tools.platform.version: sources` выпуска, который\nпишет формат исходников, среди установок нет. Установки — те, по которым решён отказ.",
      "properties": {
        "installations": {
          "description": "Установки, среди которых выпуска не нашлось, новейшие первыми.",
          "items": {
            "$ref": "#/$defs/PlatformInstallation"
          },
          "type": "array"
        },
        "source_format": {
          "$ref": "#/$defs/SourceFormatInfo",
          "description": "Формат исходников основного набора и выпуск, который его пишет; `release` — `null`,\nесли раннер такого выпуска не знает, `version` — `null`, если формат не прочитан."
        }
      },
      "required": [
        "source_format",
        "installations"
      ],
      "type": "object"
    },
    "SessionEntry": {
      "additionalProperties": false,
      "description": "Один сеанс из списка платформы.",
      "properties": {
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Устойчивый код приложения; `null` — название не из таблицы известных."
        },
        "application_title": {
          "description": "Название приложения, как его написала платформа.",
          "type": "string"
        },
        "computer": {
          "description": "Компьютер сеанса.",
          "type": "string"
        },
        "id": {
          "description": "Номер сеанса у платформы.",
          "type": [
            "string",
            "null"
          ]
        },
        "started": {
          "description": "Начало сеанса, местное время базы: `ГГГГ-ММ-ДДTчч:мм:сс`.",
          "type": "string"
        },
        "user": {
          "description": "Пользователь; текст платформы у файловой базы его не называет.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "computer",
        "application_title",
        "started"
      ],
      "type": "object"
    },
    "SessionLock": {
      "additionalProperties": false,
      "description": "Блокировка начала сеансов базы.",
      "properties": {
        "message": {
          "description": "Сообщение блокировки, если раннер его знает.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/SessionLockState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "SessionLockState": {
      "description": "Чья блокировка начала сеансов стоит у базы.",
      "oneOf": [
        {
          "const": "none",
          "description": "Блокировки нет.",
          "type": "string"
        },
        {
          "const": "own",
          "description": "Блокировка раннера.",
          "type": "string"
        },
        {
          "const": "foreign",
          "description": "Чужая блокировка; раннер её не трогает.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Узнать нельзя.",
          "type": "string"
        }
      ]
    },
    "SessionsEvidence": {
      "description": "Источник признака «базу держат сеансы».",
      "oneOf": [
        {
          "const": "executor",
          "description": "Улика исполнителя или состояния базы: `error-type` агента, его вопрос, блокировка файлов\nфайловой базы, отказ СУБД из-за подключений, у пересоздания — сеансы в `rac`: другой\nпричины отказа нет. Отказ — точно из-за сеансов.",
          "type": "string"
        },
        {
          "const": "server_list",
          "description": "Улики исполнителя нет, а собственный список сервера (`rac session list`, `ibcmd session\nlist`) называет чужие живые сеансы: база занята, но причина отказа может быть другой.",
          "type": "string"
        }
      ]
    },
    "SourceFormatInfo": {
      "additionalProperties": false,
      "description": "Формат исходников проекта.",
      "properties": {
        "file": {
          "description": "Прочитанный `Configuration.xml`.",
          "type": "string"
        },
        "release": {
          "description": "Выпуск платформы, который пишет этот формат; `null`, если раннер такого не знает.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Версия формата; `null`, если файл есть, а версии в его корне нет.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "description": "A transport-neutral execution step shared by CLI envelopes and use-case payloads.",
      "properties": {
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSet"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ExecutionError"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ExecutionStepKind"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStepStatus"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "ok",
        "status",
        "kind",
        "duration_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/IngvarConsulting/v8-runner-rust/master/docs/schemas/command-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Форма машинного ответа команды: общая часть конверта, шаги и отказ. Данные команды описывает её собственная форма из docs/schemas/command-data.",
  "properties": {
    "command": {
      "type": "string"
    },
    "data": true,
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvelopeError"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "command",
    "duration_ms",
    "data",
    "warnings",
    "steps"
  ],
  "title": "v8-runner command envelope",
  "type": "object"
}
